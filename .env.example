# ==========================================
# LUCY DENTAL CLINIC INTEGRATION SETTINGS
# ==========================================

# 1. Google Sheets Integration Webhook URL
# Deploy the Google Apps Script provided in the guide and paste the Web App URL here:
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 2. Telegram Notifications (Instant receptionist alert)
# Create a bot with @BotFather on Telegram and get the bot token:
VITE_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your Receptionist Telegram Chat ID or Group Channel ID (e.g. -100xxxxxxxxxx or your user id):
VITE_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

